{
  "name": "@amlplugins/shopify-app-bridge",
  "version": "0.0.1",
  "description": "Native @shopify/app-bridge SDK re-exported under the @amlplugins namespace — Shopify App Bridge — embedded admin app framework with iframe-bridged actions, navigation, toast, resource picker.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@shopify/app-bridge": "^3.7.11",
    "@shopify/app-bridge-react": "^4.1.6"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amlplugins/shopify-app-bridge.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
